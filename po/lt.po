#: ../src/menubar.vala:236
msgid "Onscreen keyboard"
msgstr "Klaviatūra ekrane"

#: ../src/menubar.vala:241
msgid "High Contrast"
msgstr "Didelis kontrastas"

#: ../src/menubar.vala:247
msgid "Screen Reader"
