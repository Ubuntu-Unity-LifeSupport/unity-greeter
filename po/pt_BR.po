#: ../src/user-list.vala:743
msgid "Log In"
msgstr "Iniciar sessão"

#: ../src/user-list.vala:744
#, c-format
msgid "Login as %s"
msgstr "Iniciar sessão como %s"

#: ../src/user-list.vala:748
msgid "Retry"
msgstr "Repetir"

#: ../src/user-list.vala:749
#, c-format
msgid "Retry as %s"
msgstr "Tentar novamente como %s"

#: ../src/user-list.vala:788
