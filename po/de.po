#: ../src/user-list.vala:743
msgid "Log In"
msgstr "Anmelden"

#: ../src/user-list.vala:744
#, c-format
msgid "Login as %s"
msgstr "Als %s anmelden"

#: ../src/user-list.vala:748
msgid "Retry"
msgstr "Erneut versuchen"

#: ../src/user-list.vala:749
#, c-format
msgid "Retry as %s"
msgstr "Erneut versuchen als %s"

#: ../src/user-list.vala:788
msgid "Login"
msgstr "Anmelden"

