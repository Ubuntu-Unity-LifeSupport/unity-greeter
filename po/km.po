#: ../src/main-window.vala:42
msgid "Login Screen"
msgstr "អេក្រង់​​ចូល"

#: ../src/menubar.vala:199
msgid "Onscreen keyboard"
msgstr "ក្ដារចុច​លើ​អេក្រង់"

#: ../src/menubar.vala:204
msgid "High Contrast"
msgstr "កម្រិត​ពណ៌​ខ្ពស់"

#: ../src/menubar.vala:210
msgid "Screen Reader"
msgstr "កម្មវិធី​អាន​អេក្រង់"

#. Help string for command line --version flag
#: ../src/unity-greeter.vala:30
msgid "Show release version"
msgstr "បង្ហាញ​កំណែ​ចេញ​ផ្សាយ"

#. Help string for command line --test-mode flag
#: ../src/unity-greeter.vala:33
msgid "Run in test mode"
msgstr "ដំណើរការ​ក្នុង​របៀប​សាកល្បង"

#: ../src/unity-greeter.vala:117 ../src/unity-greeter.vala:139
msgid "Guest Session"
msgstr "សម័យ​ភ្ញៀវ"

#: ../src/unity-greeter.vala:125
msgid "Login"
msgstr "ចូល"

#: ../src/unity-greeter.vala:251 ../src/unity-greeter.vala:381
#: ../src/unity-greeter.vala:400 ../src/unity-greeter.vala:430
msgid "Password:"
msgstr "ពាក្យ​សម្ងាត់ ៖"

#: ../src/unity-greeter.vala:253 ../src/unity-greeter.vala:384
msgid "Username:"
msgstr "ឈ្មោះ​អ្នក​ប្រើ ៖"

#: ../src/unity-greeter.vala:318
msgid "Invalid password, please try again"
msgstr "ពាក្យ​សម្ងាត់​មិន​ត្រឹមត្រូវ សូម​ព្យាយាម​ម្ដង​ទៀត"

#: ../src/unity-greeter.vala:323
msgid "Failed to authenticate"
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ"

#: ../src/unity-greeter.vala:351
msgid "Other..."
msgstr "ផ្សេង​​ទៀត..."

#. Arguments and description for --help text
#: ../src/unity-greeter.vala:601
msgid "- Unity Greeter"
msgstr "- សារ​ស្វាគមន៍​របស់ Unity"

#. Text printed out when an unknown command-line argument provided
#: ../src/unity-greeter.vala:612
#, c-format
msgid "Run '%s --help' to see a full list of available command line options."
msgstr ""
"ដំណើរការ '%s --help' ដើម្បី​មើល​បញ្ជី​ជម្រើស​បន្ទាត់​ពាក្យ​បញ្ជា​ពេញលេញ ។"

#: ../src/user-list.vala:156
msgid "Log In"
msgstr "ចូល"

#: ../src/user-list.vala:171
msgid "Session Options"
msgstr "ជម្រើស​សម័យ"

#: ../src/user-list.vala:278
#, c-format
msgid "Enter password for %s"
msgstr "បញ្ចូល​ពាក្យ​សម្ងាត់​សម្រាប់ %s"

#: ../src/user-list.vala:282
msgid "Enter username"
msgstr "បញ្ចូល​ឈ្មោះ​អ្នក​ប្រើ"

#: ../src/user-list.vala:284
msgid "Enter password"
msgstr "បញ្ចូល​ពាក្យ​សម្ងាត់"

#: ../src/user-list.vala:300
#, c-format
msgid "Login as %s"
msgstr "ចូល​ជា %s"

#: ../src/user-list.vala:311
msgid "Logging in..."
msgstr "កំពុង​ចូល​..."
