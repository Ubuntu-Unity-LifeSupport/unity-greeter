#: ../src/main-window.vala:42
msgid "Login Screen"
msgstr "អេក្រង់​​ចូល"

#: ../src/menubar.vala:211
msgid "Onscreen keyboard"
msgstr "ក្ដារចុច​លើ​អេក្រង់"

#: ../src/menubar.vala:216
msgid "High Contrast"
msgstr "កម្រិត​ពណ៌​ខ្ពស់"

#: ../src/menubar.vala:222
msgid "Screen Reader"
msgstr "កម្មវិធី​អាន​អេក្រង់"

#: ../src/session-chooser.vala:63
msgid "_Back"
msgstr "ថយ​ក្រោយ"

#. Help string for command line --version flag
#: ../src/unity-greeter.vala:30
msgid "Show release version"
msgstr "បង្ហាញ​កំណែ​ចេញ​ផ្សាយ"

#. Help string for command line --test-mode flag
#: ../src/unity-greeter.vala:33
msgid "Run in test mode"
msgstr "ដំណើរការ​ក្នុង​របៀប​សាកល្បង"

#: ../src/unity-greeter.vala:384 ../src/unity-greeter.vala:525
#: ../src/unity-greeter.vala:548 ../src/unity-greeter.vala:552
#: ../src/unity-greeter.vala:556 ../src/unity-greeter.vala:562
#: ../src/unity-greeter.vala:565 ../src/unity-greeter.vala:592
msgid "Password:"
msgstr "ពាក្យ​សម្ងាត់ ៖"

#: ../src/unity-greeter.vala:386 ../src/unity-greeter.vala:528
msgid "Username:"
msgstr "ឈ្មោះ​អ្នក​ប្រើ ៖"

#: ../src/unity-greeter.vala:467
msgid "Invalid password, please try again"
msgstr "ពាក្យ​សម្ងាត់​មិន​ត្រឹមត្រូវ សូម​ព្យាយាម​ម្ដង​ទៀត"

#: ../src/unity-greeter.vala:476
msgid "Failed to authenticate"
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ"

#. Arguments and description for --help text
#: ../src/unity-greeter.vala:826
msgid "- Unity Greeter"
msgstr "- សារ​ស្វាគមន៍​របស់ Unity"

#. Text printed out when an unknown command-line argument provided
#: ../src/unity-greeter.vala:837
#, c-format
msgid "Run '%s --help' to see a full list of available command line options."
msgstr ""
"ដំណើរការ '%s --help' ដើម្បី​មើល​បញ្ជី​ជម្រើស​បន្ទាត់​ពាក្យ​បញ្ជា​ពេញលេញ ។"

#: ../src/user-list.vala:80
msgid "Guest Session"
msgstr "សម័យ​ភ្ញៀវ"

#: ../src/user-list.vala:242
msgid "Session Options"
msgstr "ជម្រើស​សម័យ"

#: ../src/user-list.vala:371
#, c-format
msgid "Enter password for %s"
msgstr "បញ្ចូល​ពាក្យ​សម្ងាត់​សម្រាប់ %s"

#: ../src/user-list.vala:375
msgid "Enter username"
msgstr "បញ្ចូល​ឈ្មោះ​អ្នក​ប្រើ"

#: ../src/user-list.vala:377
msgid "Enter password"
msgstr "បញ្ចូល​ពាក្យ​សម្ងាត់"

#: ../src/user-list.vala:395
#, c-format
msgid "Login as %s"
msgstr "ចូល​ជា %s"

#. 'Log In' here is the button for logging in.
#: ../src/user-list.vala:397
msgid "Log In"
msgstr "ចូល"

#: ../src/user-list.vala:401 ../src/user-list.vala:402
msgid "Retry"
msgstr "ព្យាយាម​ម្ដង​ទៀត"

#: ../src/user-list.vala:418
msgid "Logging in..."
msgstr "កំពុង​ចូល​..."

