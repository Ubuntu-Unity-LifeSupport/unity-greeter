msgstr "Parola:"

#: ../src/greeter-list.vala:804 ../src/user-list.vala:655
msgid "Username:"
msgstr "Kullanıcı Adı:"

#: ../src/greeter-list.vala:856
msgid "Invalid password, please try again"
msgstr "Geçersiz parola, lütfen yeniden deneyin"

#: ../src/greeter-list.vala:867
msgid "Failed to authenticate"
msgstr "Kimlik doğrulama başarısız"

#: ../src/greeter-list.vala:922
msgid "Logging in…"
msgstr "Oturum açılıyor..."

#: ../src/main-window.vala:49
msgid "Login Screen"
msgstr "Giriş Ekranı"

#: ../src/main-window.vala:116
msgid "Back"
msgstr ""

#: ../src/menubar.vala:217
msgid "Onscreen keyboard"
msgstr "Ekran klavyesi"

#: ../src/menubar.vala:222
msgid "High Contrast"
msgstr "Yüksek Karşıtlık"

#: ../src/menubar.vala:228
msgid "Screen Reader"
msgstr "Ekran Okuyucu"

#: ../src/prompt-box.vala:211
msgid "Session Options"
msgstr "Oturum Seçenekleri"

#: ../src/session-list.vala:34
msgid "Select desktop environment"
msgstr "Masaüstü ortamını seçin"

#: ../src/shutdown-dialog.vala:101
msgid "Goodbye. Would you like to…"
msgstr "Görüşmek Üzere. Eğer isterseniz..."

#: ../src/shutdown-dialog.vala:105 ../src/shutdown-dialog.vala:183
msgid "Shut Down"
msgstr "Kapat"

#: ../src/shutdown-dialog.vala:112
msgid "Are you sure you want to shut down the computer?"
msgstr "Bilgisayarı kapatmak istediğinize emin misiniz?"

#: ../src/shutdown-dialog.vala:131
msgid "Suspend"
msgstr "Askıya Al"

#: ../src/shutdown-dialog.vala:148
msgid "Hibernate"
msgstr "Uykuya Al"

#: ../src/shutdown-dialog.vala:166
msgid "Restart"
msgstr "Yeniden Başlat"

#. Translators: %s is a session name like KDE or Ubuntu
#: ../src/toggle-box.vala:93
#, c-format
msgid "%s (Default)"
msgstr "%s (Öntanımlı)"

#. Help string for command line --version flag
#: ../src/unity-greeter.vala:480
msgid "Show release version"
msgstr "Dağıtımın sürümünü göster"

#. Help string for command line --test-mode flag
#: ../src/unity-greeter.vala:483
msgid "Run in test mode"
msgstr "Sınama kipinde çalıştır"

#. Arguments and description for --help text
#: ../src/unity-greeter.vala:489
msgid "- Unity Greeter"
msgstr "- Unity Karşılayıcısı"

#. Text printed out when an unknown command-line argument provided
#: ../src/unity-greeter.vala:500
#, c-format
msgid "Run '%s --help' to see a full list of available command line options."
msgstr ""
"Kullanılabilir komut satırı seçeneklerinin tam listesini görmek için '%s --"
"help' komutunu çalıştırın."

#: ../src/user-list.vala:45
msgid "Guest Session"
msgstr "Konuk Oturumu"

#: ../src/user-list.vala:398
msgid "Please enter a complete e-mail address"
msgstr "Lütfen tam bir e-posta adresi girin"

#: ../src/user-list.vala:478
msgid "Incorrect e-mail address or password"
msgstr "E-posta ya da parola  yanlış"

#: ../src/user-list.vala:509
msgid ""
"If you have an account on an RDP or Citrix server, Remote Login lets you run "
"applications from that server."
msgstr ""
"Eğer bir RDP ya da Citrix sunucusu üzerinde bir hesabınız varsa, Uzaktan "
"Giriş uygulamaları bu sunucudan çalıştırmanızı sağlar."

#. For 12.10 we still don't support Citrix
#: ../src/user-list.vala:511
msgid ""
"If you have an account on an RDP server, Remote Login lets you run "
"applications from that server."
msgstr ""
"Eğer bir RDP sunucusunda bir hesabınız varsa, Uzaktan Erişim uygulamaları bu "
"sunucudan çalıştırmanıza izin verir."

#: ../src/user-list.vala:514
msgid "Cancel"
msgstr "Vazgeç"

#: ../src/user-list.vala:515
msgid "Set Up…"
msgstr "Kurulum..."

#: ../src/user-list.vala:517
msgid ""
"You need an Ubuntu Remote Login account to use this service. Would you like "
"to set up an account now?"
msgstr ""
"Bu hizmeti kullanmak için Ubuntu Uzaktan Giriş hesabınız olması gerekir. "
"Şimdi bir hesap kurmak ister miydiniz?"

#: ../src/user-list.vala:521
msgid "OK"
msgstr "Tamam"

#: ../src/user-list.vala:522
msgid ""
"You need an Ubuntu Remote Login account to use this service. Visit "
"uccs.canonical.com to set up an account."
msgstr ""
"Bu hizmeti kullanmak için Ubuntu Uzaktan Giriş hesabınız olması gerekir. Bir "
"hesap kurmak için uccs.canonical.com adresini ziyaret edin."

#: ../src/user-list.vala:639
msgid "Server type not supported."
msgstr "Sunucu türü desteklenmiyor."

#: ../src/user-list.vala:680
msgid "Domain:"
msgstr "Alan adı:"

#: ../src/user-list.vala:741
msgid "Email address:"
msgstr "E-posta adresi:"

