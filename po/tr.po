#: ../src/user-list.vala:785
msgid "Log In"
msgstr "Oturum aç"

#: ../src/user-list.vala:786
#, c-format
msgid "Login as %s"
msgstr "%s olarak oturum aç"

#: ../src/user-list.vala:790
msgid "Retry"
msgstr "Yeniden dene"

#: ../src/user-list.vala:791
#, c-format
msgid "Retry as %s"
msgstr "%s olarak yeniden dene"

