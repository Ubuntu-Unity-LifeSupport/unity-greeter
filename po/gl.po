#: ../src/menubar.vala:236
msgid "Onscreen keyboard"
msgstr "Teclado en pantalla"

#: ../src/menubar.vala:241
msgid "High Contrast"
msgstr "Alto contraste"

#: ../src/menubar.vala:247
msgid "Screen Reader"
