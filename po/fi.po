msgid "Login Screen"
msgstr "Sisäänkirjautumisruutu"

#: ../src/menubar.vala:236
msgid "Onscreen keyboard"
msgstr "Virtuaalinäppäimistö"

#: ../src/menubar.vala:241
msgid "High Contrast"
msgstr "Suuri kontrasti"

#: ../src/menubar.vala:247
msgid "Screen Reader"
