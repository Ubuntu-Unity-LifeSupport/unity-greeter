msgid "Login Screen"
msgstr "Logind-skærm"

#: ../src/menubar.vala:236
msgid "Onscreen keyboard"
msgstr "Skærmtastatur"

#: ../src/menubar.vala:241
msgid "High Contrast"
msgstr "Høj kontrast"

#: ../src/menubar.vala:247
msgid "Screen Reader"
