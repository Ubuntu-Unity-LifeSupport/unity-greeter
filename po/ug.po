#: ../src/greeter-list.vala:245
#, c-format
msgid "Enter password for %s"
msgstr "%s نىڭ ئىمنى كىرگۈزۈڭ"

#: ../src/greeter-list.vala:735 ../src/user-list.vala:622
#: ../src/user-list.vala:1340 ../src/user-list.vala:1434
#: ../src/user-list.vala:1457 ../src/user-list.vala:1461
#: ../src/user-list.vala:1465 ../src/user-list.vala:1471
#: ../src/user-list.vala:1475 ../src/user-list.vala:1478
msgid "Password:"
msgstr "ئىم:"

#: ../src/greeter-list.vala:737 ../src/user-list.vala:616
#: ../src/user-list.vala:1437
msgid "Username:"
msgstr "ئىشلەتكۈچى ئاتى:"

#: ../src/greeter-list.vala:789
msgid "Invalid password, please try again"
msgstr "ئىم خاتا، قايتا سىناڭ"

#: ../src/greeter-list.vala:800
msgid "Failed to authenticate"
msgstr "كىملىك دەلىللەش مەغلۇپ بولدى"

#: ../src/greeter-list.vala:855
msgid "Logging in..."
msgstr "كىرىۋاتىدۇ…"

#: ../src/main-window.vala:47
msgid "Login Screen"
msgstr "كىرىش ئېكرانى"

#: ../src/menubar.vala:236
msgid "Onscreen keyboard"
msgstr "ئېكران ھەرپتاختىسى"

#: ../src/menubar.vala:241
msgid "High Contrast"
msgstr "يۇقىرى ئاق-قارىلىق"

#: ../src/menubar.vala:247
msgid "Screen Reader"
msgstr "ئېكران ئوقۇغۇچ"

#: ../src/prompt-box.vala:211
msgid "Session Options"
msgstr "ئەڭگىمە تاللانمىسى"

#: ../src/session-list.vala:34
msgid "Select desktop environment"
msgstr "ئۈستەلئۈستى مۇھىتىنى تاللاڭ"

#. Translators: %s is a session name like KDE or Ubuntu
#: ../src/toggle-box.vala:93
#, c-format
msgid "%s (Default)"
msgstr "%s (كۆڭۈلدىكى)"

#. Help string for command line --version flag
#: ../src/unity-greeter.vala:450
msgid "Show release version"
msgstr "نەشرىنى كۆرسىتىدۇ"

#. Help string for command line --test-mode flag
#: ../src/unity-greeter.vala:453
msgid "Run in test mode"
msgstr "سىناق ھالەتتە ئىجرا قىلىدۇ"

#. Arguments and description for --help text
#: ../src/unity-greeter.vala:459
msgid "- Unity Greeter"
msgstr "- Unity كۈتۈۋالغۇچىسى"

#. Text printed out when an unknown command-line argument provided
#: ../src/unity-greeter.vala:470
#, c-format
msgid "Run '%s --help' to see a full list of available command line options."
msgstr ""
"«%s --help» كىرگۈزسىڭىز بۇيرۇق قۇرىدا ئىشلەتكىلى بولىدىغان بارلىق "
"تاللانمىلارنى كۆرەلەيسىز."

#: ../src/user-list.vala:45
msgid "Guest Session"
msgstr "مېھمان"

#: ../src/user-list.vala:367
msgid "Please enter a complete e-mail address"
msgstr "ئېلخەت ئادرېسىنى كىرگۈزۈڭ"

#: ../src/user-list.vala:442
msgid "Incorrect e-mail address or password"
msgstr "ئېلخەت ئادرېسى ياكى ئىم توغرا ئەمەس"

#: ../src/user-list.vala:473
msgid ""
"If you have an account on an RDP or Citrix server, Remote Login lets you run "
"applications from that server."
msgstr ""
"ئەگەر سىزنىڭ RDP ياكى Citrix مۇلازىمېتىرىدا ھېساباتىڭىز بار بولسا، يىراقتىن "
"كىرىش ئارقىلىق بۇ مۇلازىمېتىرلاردىكى پروگراممىلارنى ئىجرا قىلالايسىز."

#. For 12.10 we still don't support Citrix
#: ../src/user-list.vala:475
msgid ""
"If you have an account on an RDP server, Remote Login lets you run "
"applications from that server."
msgstr ""
"سىزنىڭ RDP مۇلازىمېتىرىدا ھېساباتىڭىز بولسا، يىراقتىن كىرىش ئارقىلىق، شۇ "
"مۇلازىمېتىر ئۈستىدىكى پروگراممىلارنى ئىجرا قىلالايسىز."

#: ../src/user-list.vala:478
msgid "Cancel"
msgstr "ئەمەلدىن قالدۇر"

#: ../src/user-list.vala:479
msgid "Set Up…"
msgstr "ھېساب قۇرۇش…"

#: ../src/user-list.vala:481
msgid ""
"You need an Ubuntu Remote Login account to use this service. Would you like "
"to set up an account now?"
msgstr ""
"مەزكۇر مۇلازىمەتنى ئىشلىتىش ئۈچۈن چوقۇم ئۇبۇنتۇ يىراقتىن كىرىش ھېساباتى "
"زۆرۈردۇر. ھازىرلا ھېساب قۇرامسىز؟"

#: ../src/user-list.vala:485
msgid "OK"
msgstr "تامام"

#: ../src/user-list.vala:486
msgid ""
"You need an Ubuntu Remote Login account to use this service. Visit "
"uccs.canonical.com to set up an account."
msgstr ""
"مەزكۇر مۇلازىمەتنى ئىشلىتىش ئۈچۈن چوقۇم ئۇبۇنتۇ يىراقتىن كىرىش ھېساباتى "
"زۆرۈردۇر. ھېساب قۇرۇش ئۈچۈن uccs.canonical.com نى زىيارەت قىلىڭ."

#: ../src/user-list.vala:600
msgid "Server type not supported."
msgstr "مۇلازىمېتىر تىپىنى ئىشلەتكىلى بولمايدۇ."

#: ../src/user-list.vala:641
msgid "Domain:"
msgstr "دائىرە:"

#: ../src/user-list.vala:702
msgid "Email address:"
msgstr "ئېلخەت مەنزىل:"

#. 'Log In' here is the button for logging in.
#: ../src/user-list.vala:746
msgid "Log In"
msgstr "كىر"

#: ../src/user-list.vala:747
#, c-format
msgid "Login as %s"
msgstr "%s سۈپىتىدە كىرىڭ"

#: ../src/user-list.vala:751
msgid "Retry"
msgstr "قايتا سىنا"

#: ../src/user-list.vala:752
#, c-format
msgid "Retry as %s"
msgstr "قايتا سىنا (%s سۈپىتىدە)"

#: ../src/user-list.vala:791
msgid "Login"
msgstr "كىر"

#: ../src/user-list.vala:1474
msgid "Favorite Color (blue):"
msgstr "ئامراق رەڭ (كۆك):"

