#: ../src/greeter-list.vala:300
#, c-format
msgid "Enter password for %s"
msgstr "Въведете парола за %s"

#: ../src/greeter-list.vala:802 ../src/user-list.vala:661
msgid "Password:"
msgstr "Парола:"

#: ../src/greeter-list.vala:804 ../src/user-list.vala:655
msgid "Username:"
msgstr "Потребител:"

#: ../src/greeter-list.vala:856
msgid "Invalid password, please try again"
msgstr "Грешна парола, моля опитайте отново"

#: ../src/greeter-list.vala:867
msgid "Failed to authenticate"
msgstr "Неуспешно идентифициране"

#: ../src/greeter-list.vala:922
msgid "Logging in…"
msgstr "Влизане..."

#: ../src/main-window.vala:49
msgid "Login Screen"
msgstr "Екран за вход в системата"

#: ../src/main-window.vala:116
msgid "Back"
msgstr "Назад"

#: ../src/menubar.vala:220
msgid "Onscreen keyboard"
msgstr "Екранна клавиатура"

#: ../src/menubar.vala:225
msgid "High Contrast"
msgstr "Висок контраст"

#: ../src/menubar.vala:231
msgid "Screen Reader"
msgstr "Екранен четец"

#: ../src/prompt-box.vala:211
msgid "Session Options"
msgstr "Параметри на сесията"

#: ../src/session-list.vala:34
msgid "Select desktop environment"
msgstr "Изберете десктоп среда"

#: ../src/shutdown-dialog.vala:101
msgid "Goodbye. Would you like to…"
msgstr "Довиждане. Бихте ли искали да.."

#: ../src/shutdown-dialog.vala:105 ../src/shutdown-dialog.vala:183
msgid "Shut Down"
msgstr "Изключи"

#: ../src/shutdown-dialog.vala:112
msgid "Are you sure you want to shut down the computer?"
msgstr "Действително ли искате да изключите компютъра?"

#: ../src/shutdown-dialog.vala:131
msgid "Suspend"
msgstr "Суспендинирай"

#: ../src/shutdown-dialog.vala:148
msgid "Hibernate"
msgstr "Хибернирай"

#: ../src/shutdown-dialog.vala:166
msgid "Restart"
msgstr "Рестартирай"

#. Translators: %s is a session name like KDE or Ubuntu
#: ../src/toggle-box.vala:93
#, c-format
msgid "%s (Default)"
msgstr "%s (по подразбиране)"

#. Help string for command line --version flag
#: ../src/unity-greeter.vala:482
msgid "Show release version"
msgstr "Покажи версията на реализа"

#. Help string for command line --test-mode flag
#: ../src/unity-greeter.vala:485
msgid "Run in test mode"
msgstr "Стартирай в тестов режим"

#. Arguments and description for --help text
#: ../src/unity-greeter.vala:491
msgid "- Unity Greeter"
msgstr "- Екран за поздрав на Юнити"

#. Text printed out when an unknown command-line argument provided
#: ../src/unity-greeter.vala:502
#, c-format
msgid "Run '%s --help' to see a full list of available command line options."
msgstr ""
"Изпълнете «%s --help», за да видите списъка с всички опции на командния ред."

#: ../src/user-list.vala:45
msgid "Guest Session"
msgstr "Сесия за гости"

#: ../src/user-list.vala:398
msgid "Please enter a complete e-mail address"
msgstr "Моля, напишете пълен имейл адрес"

#: ../src/user-list.vala:478
msgid "Incorrect e-mail address or password"
msgstr "Невалиден имейл адрес или парола"

#: ../src/user-list.vala:509
msgid ""
"If you have an account on an RDP or Citrix server, Remote Login lets you run "
"applications from that server."
msgstr ""
"Ако имате акаунт на RDP или Citrix сървър, отдалеченото влизане ще ви "
"позволи да стартирате приложения от този сървър."

#. For 12.10 we still don't support Citrix
#: ../src/user-list.vala:511
msgid ""
"If you have an account on an RDP server, Remote Login lets you run "
"applications from that server."
msgstr ""
"Ако имате акаунт на RDP сървър, отдалеченото влизане ще ви позволи да "
"стартирате приложения от този сървър."

#: ../src/user-list.vala:514
msgid "Cancel"
msgstr "Отмени"

#: ../src/user-list.vala:515
msgid "Set Up…"
msgstr "Настройка..."

#: ../src/user-list.vala:517
msgid ""
"You need an Ubuntu Remote Login account to use this service. Would you like "
"to set up an account now?"
msgstr ""
"За да ползвате тази услуга, трябва да имате Ubuntu Remote Login акаунт. "
"Искате ли да създаде акаунта си сега?"

#: ../src/user-list.vala:521
msgid "OK"
msgstr "Да"

#: ../src/user-list.vala:522
msgid ""
"You need an Ubuntu Remote Login account to use this service. Visit "
"uccs.canonical.com to set up an account."
msgstr ""
"За да ползвате тази услуга, трябва да имате Ubuntu Remote Login акаунт. За "
"да настройте акаута си, посетите сайта uccs.canonical.com"

#: ../src/user-list.vala:639
msgid "Server type not supported."
msgstr "Този тип на сървъра не се поддържа."

#: ../src/user-list.vala:680
msgid "Domain:"
msgstr "Домейн:"

#: ../src/user-list.vala:741
msgid "Email address:"
msgstr "Имейл адрес:"

#. 'Log In' here is the button for logging in.
#: ../src/user-list.vala:785
msgid "Log In"
msgstr "Вход"

#: ../src/user-list.vala:786
#, c-format
msgid "Login as %s"
msgstr "Влез от името на %s"

#: ../src/user-list.vala:790
msgid "Retry"
msgstr "Повторен опит"

#: ../src/user-list.vala:791
#, c-format
msgid "Retry as %s"
msgstr "Повторен опит като %s"

