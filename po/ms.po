#: ../src/greeter-list.vala:245
#, c-format
msgid "Enter password for %s"
msgstr "Masukkan kata laluan untuk %s"

#: ../src/greeter-list.vala:725 ../src/user-list.vala:615
#: ../src/user-list.vala:1318 ../src/user-list.vala:1412
#: ../src/user-list.vala:1435 ../src/user-list.vala:1439
#: ../src/user-list.vala:1443 ../src/user-list.vala:1449
#: ../src/user-list.vala:1453 ../src/user-list.vala:1456
msgid "Password:"
msgstr "Kata Laluan:"

#: ../src/greeter-list.vala:727 ../src/user-list.vala:609
#: ../src/user-list.vala:1415
msgid "Username:"
msgstr "Nama Pengguna:"

#: ../src/greeter-list.vala:779
msgid "Invalid password, please try again"
msgstr "Kata laluan tidak sah, sila cuba lagi"

#: ../src/greeter-list.vala:790
msgid "Failed to authenticate"
msgstr "Gagal disahihkan"

#: ../src/greeter-list.vala:845
msgid "Logging in..."
msgstr "Mendaftar masuk..."

#: ../src/main-window.vala:44
msgid "Login Screen"
msgstr "Skrin Daftar Masuk"

#: ../src/menubar.vala:222
msgid "Onscreen keyboard"
msgstr "Papan kekunci atas skrin"

#: ../src/menubar.vala:227
msgid "High Contrast"
msgstr "Beza Jelas Tinggi"

#: ../src/menubar.vala:233
msgid "Screen Reader"
msgstr "Pembaca Skrin"

#: ../src/prompt-box.vala:205
msgid "Session Options"
msgstr "Pilihan Sesi"

#: ../src/session-list.vala:34
msgid "Select desktop environment"
msgstr "Pilih persekitaran desktop"

#: ../src/session-list.vala:51 ../src/user-list.vala:478
msgid "OK"
msgstr "OK"

#. Translators: %s is a session name like KDE or Ubuntu
#: ../src/session-list.vala:86
#, c-format
msgid "%s (Default)"
msgstr "%s (Lalai)"

#. Help string for command line --version flag
#: ../src/unity-greeter.vala:416
msgid "Show release version"
msgstr "Papar versi keluaran"

#. Help string for command line --test-mode flag
#: ../src/unity-greeter.vala:419
msgid "Run in test mode"
msgstr "Jalan dalam mod ujian"

#. Arguments and description for --help text
#: ../src/unity-greeter.vala:425
msgid "- Unity Greeter"
msgstr "- Aluan Unity"

#. Text printed out when an unknown command-line argument provided
#: ../src/unity-greeter.vala:436
#, c-format
msgid "Run '%s --help' to see a full list of available command line options."
msgstr ""
"Jalankan '%s --help' untuk melihat senarai penuh pilihan baris perintah yang "
"ada."

#: ../src/user-list.vala:45
msgid "Guest Session"
msgstr "Sesi Tetamu"

#: ../src/user-list.vala:366
msgid "Please enter a complete e-mail address"
msgstr "Sila masukkan alamat e-mel lengkap"

#: ../src/user-list.vala:437
msgid "Incorrect e-mail address or password"
msgstr "Alamat e-mel atau kata laluan tidak betul"

#: ../src/user-list.vala:468
msgid ""
"If you have an account on an RDP or Citrix server, Remote Login lets you run "
"applications from that server."
msgstr ""
"Jika anda mempunyai pelayan RDP atau Citrix, Daftar Masuk Jauh benarkan anda "
"jalani aplikasi dari pelayan tersebut."

#: ../src/user-list.vala:471
msgid "Cancel"
msgstr "Batal"

#: ../src/user-list.vala:472
msgid "Set Up…"
msgstr "Persediaan..."

#: ../src/user-list.vala:474
msgid ""
"You need an Ubuntu Remote Login account to use this service. Would you like "
"to set up an account now?"
msgstr ""
"Anda perlu akaun Daftar Masuk Jauh untuk guna perkhidmatan ini. Anda hendak "
"pasang akaun sekarang?"

#: ../src/user-list.vala:479
msgid ""
"You need an Ubuntu Remote Login account to use this service. Visit "
"uccs.canonical.com to set up an account."
msgstr ""
"Anda perlu akaun Daftar Masuk Jauh untuk guna perkhidmatan ini. Lawari "
"uccs.canonical.com untuk pasang akaun."

#: ../src/user-list.vala:593
msgid "Server type not supported."
msgstr "Jenis pelayan tidak disokong."

#: ../src/user-list.vala:634
msgid "Domain:"
msgstr "Domain:"

#: ../src/user-list.vala:695
msgid "Email address:"
msgstr "Alamat e-mel:"

#. 'Log In' here is the button for logging in.
#: ../src/user-list.vala:739
msgid "Log In"
msgstr "Daftar Masuk"

#: ../src/user-list.vala:740
#, c-format
msgid "Login as %s"
msgstr "Daftar masuk sebagai %s"

#: ../src/user-list.vala:744
msgid "Retry"
msgstr "Cuba lagi"

#: ../src/user-list.vala:745
#, c-format
msgid "Retry as %s"
msgstr "Cuba sekali lagi sebagai %s"

#: ../src/user-list.vala:784
msgid "Login"
msgstr "Daftar Masuk"

#: ../src/user-list.vala:1452
msgid "Favorite Color (blue):"
msgstr "Warna Kegemaran (biru):"

