msgstr "Fallu d'autenticación"

#: ../src/greeter-list.vala:903
msgid "Logging in..."
msgstr "Aniciando sesión..."

#: ../src/main-window.vala:47
msgid "Login Screen"
msgstr "Pantalla d'accesu"

#: ../src/menubar.vala:236
msgid "Onscreen keyboard"
msgstr "Tecláu en pantalla"

#: ../src/menubar.vala:241
msgid "High Contrast"
msgstr "Altu contraste"

#: ../src/menubar.vala:247
msgid "Screen Reader"
msgstr "Llector de pantalla"

